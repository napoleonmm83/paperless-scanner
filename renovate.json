{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["npm", "dockerfile", "docker-compose"],
  "automerge": false,
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["functions/package.json"],
      "enabled": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["fabernovel/android"],
      "versioning": "regex:^(?<compatibility>api-\\d+-gcloud)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
