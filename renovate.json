{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["npm", "dockerfile", "docker-compose"],
  "automerge": false,
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["functions/package.json"],
      "enabled": true
    }
  ]
}
