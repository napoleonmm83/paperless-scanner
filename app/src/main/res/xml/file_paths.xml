<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      SECURITY (#241): expose only purpose-scoped cache subdirectories, NOT the
      cache root ("/"). Names mirror com.paperless.scanner.util.SharedFileCache.
    -->
    <cache-path name="shared_pdfs" path="shared_pdfs/" />
    <cache-path name="shared_images" path="shared_images/" />
    <!--
      Diagnostic reports a user chooses to mail us. Its own subdirectory rather than
      reusing shared_pdfs: a report is not a document, and the sweep that ages out
      downloaded PDFs should not be reasoning about both.
    -->
    <cache-path name="shared_reports" path="shared_reports/" />
</paths>
